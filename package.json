{
  "name": "ja-grants-poc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint src && npm run format:check",
    "format": "prettier --write 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' '*.{js,ts}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}' 'e2e/**/*.ts' '*.{js,ts}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
